{
  "name": "Resume Scorer",
  "version": "1.0.0",
  "description": "Score your resume against job descriptions with AI-powered analysis",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Resume Scorer",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "contextMenus",
    "commands"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "*://*.glassdoor.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "*://resume-scorer-server.vercel.app/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/vendor/pdf.mjs", "lib/vendor/pdf.worker.min.mjs", "lib/vendor/mammoth.browser.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "score-resume": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Resume Scorer popup"
    }
  }
}